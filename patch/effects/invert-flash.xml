<?xml version='1.0' encoding='UTF-8' ?>
<effect id="com.wowmancode.effects.invertflash" name="@string/name" desc="@string/desc" category="color" tags="color,glitch,raster,auto" thumb="thumb/invert.webp">
    <strings>
        <locale lang="en">
            <string name="name">Invert Flash</string>
            <string name="desc">Flashes between the original layer and an RGB-inverted version.</string>
            <string name="frequency">Frequency</string>
            <string name="duty">Invert Time</string>
            <string name="phase">Phase</string>
        </locale>
    </strings>
    <params>
        <texture id="inputImg" srcType="content" />
        <spinner id="frequency" default="2.0" min="0.05" max="30.0" step="0.05" label="@string/frequency" type="hz" />
        <spinner id="duty" default="0.5" min="0.01" max="0.99" step="0.01" label="@string/duty" type="percent" />
        <spinner id="phase" default="0.0" min="-10.0" max="10.0" step="0.01" label="@string/phase" />
    </params>
    <shader type="fragment" precision="high"><![CDATA[
        void main() {
            vec4 c = texture2DCv(inputImg.texture, acScreenNorm);
            float cycle = fract(acTime * frequency + phase);
            if (cycle < duty) {
                c.rgb = vec3(c.a) - c.rgb;
            }
            gl_FragColor = c;
        }
    ]]></shader>
</effect>
